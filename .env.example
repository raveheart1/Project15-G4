# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# All variables are optional for local/offline use; the app and tests fall
# back to empty defaults when they are unset (see elephantcallscounter/config/env.py).

# --- Google Maps (web map in the Flask UI) ---
GOOGLE_API_KEY=

# --- Azure IoT Hub / Event Hub (device simulator + cloud ingestion) ---
DEVICE_CONNECTION_STRING=
IOT_HUB_CONN_STRING=
EVENTHUB_CONN_STRING=

# --- Azure Blob / Queue Storage ---
CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
STORAGE_ACCOUNT_SAS_KEY=

# --- AWS S3 (data import via azcopy/boto3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional path overrides (default to bundled metadata paths) ---
# TRAINING_FILE_PATH=
# TEST_FILE_PATH=

# --- Sensitive: out-of-repo device coordinates (see DATA_ETHICS.md) ---
# Point this at a JSON file kept OUT of version control with the shape
# {"nn01a": {"lat": ..., "lng": ...}, ...}. If unset, approximate region
# centroids from constants.py are used.
# DEVICE_LOCATIONS_FILE=
